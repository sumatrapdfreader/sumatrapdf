# https://clangd.llvm.org/config#files
# include paths and defines are in compile_flags.txt (clangd resolves
# them relative to the repo root, which doesn't work from this file)
# .h is ambiguous (C vs C++); treat non-.c TUs as C++ so -std=c++17 is valid
# (otherwise clangd opens Crypto.h etc. as C and errors: drv_argument_not_allowed_with)
If:
  PathExclude:
    - .*\.c
CompileFlags:
  Add:
    - -x
    - c++
    - -std=c++17
---
If:
  PathExclude:
    - mupdf/.*
    - ext/.*

Diagnostics:
  # Base.h is the required first include in every .cpp; Include Cleaner often
  # marks it unused even though the rest of the TU depends on its preamble.
  Includes:
    IgnoreHeader:
      - base/Base\.h
  Suppress:
    - unused-parameter # example 1
    - misc-use-internal-linkage
    - misc-use-anonymous-namespace
    - readability-identifier-length
    - readability-implicit-bool-conversion
    - bugprone-switch-missing-default-case
    - readability-avoid-unconditional-preprocessor-if
    - bugprone-easily-swappable-parameters
    - readability-isolate-declaration
    - readability-function-cognitive-complexity
    - readability-qualified-auto
    - modernize-use-auto
    - modernize-use-nodiscard
    - bugprone-derived-method-shadowing-base-method
    - readability-simplify-boolean-expr
    - readability-use-std-min-max
    - readability-named-parameter
    - readability-non-const-parameter
    - readability-braces-around-statements
    - readability-uppercase-literal-suffix
    - modernize-macro-to-enum
    - bugprone-reserved-identifier
    - readability-named-parameter
    - misc-multiple-inheritance
    - readability-avoid-nested-conditional-operator
    - misc-use-internal-linkage
    - modernize-use-auto
    - misc-use-internal-linkage
    - modernize-avoid-setjmp-longjmp
---
# When editing a header under src/base/, force-include Base.h plus other
# src/base/*.h not already included by Base.h (headers are not self-sufficient).
If:
  PathMatch: src/base/.*\.h
CompileFlags:
  Add:
    - -include
    - base/Base.h
    - -include
    - base/Archive.h
    - -include
    - base/BitManip.h
    - -include
    - base/ByteReaderWriter.h
