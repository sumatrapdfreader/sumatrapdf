    - base/FileWatcher.h
    - -include
    - base/FrameTimeoutCalculator.h
    - -include
    - base/GdiPlusUtil.h
    - -include
    - base/GuessFileType.h
    - -include
    - base/HtmlTags.h
    - -include
    - base/Http.h
    - -include
    - base/JsonParser.h
    - -include
    - base/LzmaSimpleArchive.h
    - -include
    - base/Pixmap.h
    - -include
    - base/ScopedWin.h
    - -include
    - base/SettingsUtil.h
    - -include
    - base/SquareTreeParser.h
    - -include
    - base/StrQueue.h
    - -include
