// English (United States) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_RESOURCE
 PRODUCTVERSION VER_RESOURCE
 FILEFLAGSMASK 0x0L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "FileDescription", kAppName
            VALUE "FileVersion", VER_RESOURCE_STR
            VALUE "LegalCopyright", kCopyrightStr
            VALUE "ProductName", kAppName
            VALUE "ProductVersion", VER_RESOURCE_STR
            VALUE "CompanyName", kPublisherStr
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END

/////////////////////////////////////////////////////////////////////////////

// when building fully static, portable executable, INSTALL_PAYLOAD_ZIP is not defined
// for combined executable / installer, it's an lzsa archive that contains
// libsumatrapdf.dll, PdfPreview.dll and PdfFilter.dll
#ifdef INSTALL_PAYLOAD_ZIP
IDR_DLL_PAK             RCDATA               QM(INSTALL_PAYLOAD_ZIP)
#endif

IDR_EMBEDDED_PAK        RCDATA               "..\\.work\\embedded.dat"

/////////////////////////////////////////////////////////////////////////////

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_SUMATRAPDF          ICON "..\\gfx\\SumatraPDF-smaller.ico"
// for compath with pre 3.4 registry association for pre-win10
// have icon as ,1, which is index of this icon. unless we delete
// those old registry on install, the icon would change
2                       ICON "..\\gfx\\SumatraPDF-smaller.ico"
// Document-type icons (resource id = registry DefaultIcon ,-N). See RegisterForOpenWith.
3                       ICON "..\\gfx\\epub-32bit.ico"
4                       ICON "..\\gfx\\cbx-32bit.ico"
5                       ICON "..\\gfx\\chm-32bit.ico"
6                       ICON "..\\gfx\\djvu-32bit.ico"
7                       ICON "..\\gfx\\img-32bit.ico"
8                       ICON "..\\gfx\\pdf-32bit.ico"
9                       ICON "..\\gfx\\mobi-32bit.ico"

    /////////////////////////////////////////////////////////////////////////////

IDB_RELOADING_CUE       BITMAP                  "reloading.bmp"

/////////////////////////////////////////////////////////////////////////////

IDD_PROPSHEET_PRINT_ADVANCED DIALOGEX 0, 0, 292, 194
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Advanced"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Print range",IDC_SECTION_PRINT_RANGE,7,7,278,52
    CONTROL         "&All selected pages",IDC_PRINT_RANGE_ALL,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,14,18,264,9
    CONTROL         "&Odd pages only",IDC_PRINT_RANGE_ODD,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,14,31,264,9
    CONTROL         "&Even pages only",IDC_PRINT_RANGE_EVEN,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,14,44,264,9
    GROUPBOX        "Page scaling",IDC_SECTION_PRINT_SCALE,7,62,278,65
    CONTROL         "&Shrink pages to printable area (if necessary)",IDC_PRINT_SCALE_SHRINK,
                    "Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,14,74,264,9
    CONTROL         "&Fit pages to printable area",IDC_PRINT_SCALE_FIT,
                    "Button",BS_AUTORADIOBUTTON | WS_TABSTOP,14,87,264,9
    CONTROL         "S&tretch pages to fill paper (ignore aspect ratio)",IDC_PRINT_SCALE_STRETCH,
                    "Button",BS_AUTORADIOBUTTON | WS_TABSTOP,14,100,264,9
    CONTROL         "&Use original page sizes",IDC_PRINT_SCALE_NONE,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,14,113,264,9
    CONTROL         "Center page hori&zontally on the paper",IDC_PRINT_CENTER_HORIZONTALLY,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,133,278,10
    CONTROL         "Choose &paper source by document page size",IDC_PRINT_PAPER_SOURCE_BY_SIZE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,146,278,10
    CONTROL         "Print each page at its &document page size (mixed sizes)",IDC_PRINT_PER_PAGE_PAPER_SIZE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,159,278,10
    LTEXT           "&Rotate printout:",IDC_PRINT_ROTATE_LABEL,7,175,72,9
    COMBOBOX        IDC_PRINT_ROTATE,82,173,90,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END

