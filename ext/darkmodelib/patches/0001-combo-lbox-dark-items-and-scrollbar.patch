+/**
+ * ComboLBox (the popup list of a combo). Items are unthemed so
+ * WM_CTLCOLORLISTBOX applies; hook GetSysColor while painting so
+ * COLOR_WINDOW / COLOR_WINDOWTEXT match the dark palette. The scrollbar
+ * is painted in WM_NCPAINT (SumatraPDF #6000).
+ */
+LRESULT CALLBACK dmlib_subclass::ComboLBoxSubclass(
+	HWND hWnd,
+	UINT uMsg,
+	WPARAM wParam,
+	LPARAM lParam,
+	UINT_PTR uIdSubclass,
+	[[maybe_unused]] DWORD_PTR dwRefData
+) noexcept
+{
+	switch (uMsg)
+	{
+		case WM_NCDESTROY:
+		{
+			::RemoveWindowSubclass(hWnd, ComboLBoxSubclass, uIdSubclass);
+			break;
+		}
+
+		case WM_PAINT:
+		case WM_ERASEBKGND:
+		case WM_PRINT:
+		case WM_PRINTCLIENT:
+		case WM_NCPAINT:
+		{
+			if (!dmlib::isEnabled())
+			{
+				break;
+			}
+			const auto sysColorHook = dmlib_hook::AutoHook<dmlib_hook::GetSysColor>();
+			const LRESULT retVal = ::DefSubclassProc(hWnd, uMsg, wParam, lParam);
+			if (uMsg == WM_NCPAINT || uMsg == WM_PAINT || uMsg == WM_PRINT)
+			{
+				paintComboLBoxScrollBar(hWnd);
+			}
+			return retVal;
+		}
+
 		default:
 		{
 			break;
