+// Classic ComboLBox scrollbars ignore WM_CTLCOLOR* and stay light. Paint a
+// dark track + thumb over the non-client strip (SumatraPDF #6000).
+static void paintComboLBoxScrollBar(HWND hWnd) noexcept
+{
+	const auto style = ::GetWindowLongPtr(hWnd, GWL_STYLE);
+	if ((style & WS_VSCROLL) == 0)
+	{
+		return;
+	}
+
+	RECT rcWnd{};
+	::GetWindowRect(hWnd, &rcWnd);
+	const int wndW = rcWnd.right - rcWnd.left;
+	const int wndH = rcWnd.bottom - rcWnd.top;
+	const int sbW = ::GetSystemMetrics(SM_CXVSCROLL);
+	int border = 0;
+	if ((style & WS_BORDER) == WS_BORDER)
+	{
+		border = ::GetSystemMetrics(SM_CXBORDER);
+	}
+
+	const bool rtl = (::GetWindowLongPtr(hWnd, GWL_EXSTYLE) & WS_EX_LAYOUTRTL) == WS_EX_LAYOUTRTL;
+	RECT rcTrack{};
+	if (rtl)
+	{
+		rcTrack = { border, border, border + sbW, wndH - border };
+	}
+	else
+	{
+		rcTrack = { wndW - border - sbW, border, wndW - border, wndH - border };
+	}
+
+	HDC hdc = ::GetWindowDC(hWnd);
+	if (hdc == nullptr)
+	{
+		return;
+	}
+	::FillRect(hdc, &rcTrack, dmlib::getCtrlBackgroundBrush());
+
+	SCROLLINFO si{};
+	si.cbSize = sizeof(si);
+	si.fMask = SIF_ALL;
+	if (::GetScrollInfo(hWnd, SB_VERT, &si) == TRUE && si.nMax > si.nMin)
+	{
+		const int trackH = rcTrack.bottom - rcTrack.top;
+		const int range = si.nMax - si.nMin + 1;
+		const int page = si.nPage > 0 ? static_cast<int>(si.nPage) : 1;
+		int thumbH = static_cast<int>((static_cast<long long>(trackH) * page) / range);
+		if (thumbH < sbW)
+		{
+			thumbH = sbW;
+		}
+		if (thumbH > trackH)
+		{
+			thumbH = trackH;
+		}
+		const int maxPos = range - page;
+		int thumbY = rcTrack.top;
+		if (maxPos > 0)
+		{
+			thumbY += static_cast<int>((static_cast<long long>(trackH - thumbH) * si.nPos) / maxPos);
+		}
+		RECT rcThumb{ rcTrack.left + 1, thumbY, rcTrack.right - 1, thumbY + thumbH };
+		::FillRect(hdc, &rcThumb, dmlib::getHotBackgroundBrush());
+	}
+
+	::ReleaseDC(hWnd, hdc);
+}
