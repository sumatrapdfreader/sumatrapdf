// English (United States) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_DEMO                ICON                    "demo.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_DEMO MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit",                       IDM_EXIT
    END
    POPUP "&Mode"
    BEGIN
        MENUITEM "&Dark",                       IDM_DARK
        MENUITEM "&Light",                      IDM_LIGHT
        MENUITEM "&Classic",                    IDM_CLASSIC
    END
    POPUP "&Dialogs"
    BEGIN
        MENUITEM "Choose &Color",               IDM_CHOOSECOLOR
        MENUITEM "Choose &Font",                IDM_CHOOSEFONT
        MENUITEM "&Task Dialog",                IDM_TASKDIALOG
        MENUITEM "&Message Box",                IDM_MSGBOX
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About ...",                  IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_DEMO ACCELERATORS
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About darkmodelib demo"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    ICON            IDI_DEMO,IDC_STATIC,14,14,21,20
    LTEXT           "Darkmodelib demo",IDC_ABOUT_VERSION,42,14,114,8,SS_NOPREFIX
    LTEXT           DM_COPYRIGHT,IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "OK",IDOK,113,41,50,14,WS_GROUP
END

IDD_DARK_FONT_DIALOG DIALOG 13, 54, 243, 234
STYLE DS_SETFONT | DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Font"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "&Font:",1088,7,7,98,9
    COMBOBOX        1136,7,16,98,76,CBS_SIMPLE | CBS_OWNERDRAWFIXED | CBS_AUTOHSCROLL | CBS_SORT | CBS_HASSTRINGS | CBS_DISABLENOSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Font st&yle:",1089,114,7,74,9
    COMBOBOX        1137,114,16,74,76,CBS_SIMPLE | CBS_OWNERDRAWFIXED | CBS_AUTOHSCROLL | CBS_HASSTRINGS | CBS_DISABLENOSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Size:",1090,198,7,36,9
    COMBOBOX        1138,198,16,36,76,CBS_SIMPLE | CBS_AUTOHSCROLL | CBS_SORT | CBS_HASSTRINGS | CBS_DISABLENOSCROLL | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Effects",1072,7,97,98,76,WS_GROUP
    CONTROL         "Stri&keout",1040,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,111,90,10
    CONTROL         "&Underline",1041,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,127,90,10
    LTEXT           "&Color:",1091,13,144,89,9
    COMBOBOX        1139,13,155,85,100,CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_AUTOHSCROLL | CBS_HASSTRINGS | WS_BORDER | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Sample",1073,114,97,120,43,WS_GROUP
    CTEXT           "AaBbYyZz",1092,116,106,117,33,SS_NOPREFIX | NOT WS_VISIBLE
    LTEXT           "",1093,7,178,227,20,SS_NOPREFIX | NOT WS_GROUP
    LTEXT           "Sc&ript:",1094,114,145,118,9
    COMBOBOX        1140,114,155,120,30,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | CBS_HASSTRINGS | WS_BORDER | WS_VSCROLL | WS_TABSTOP
    CONTROL         "<A>Show more fonts</A>",1592,"SysLink",WS_TABSTOP,7,199,227,9
    DEFPUSHBUTTON   "OK",IDOK,141,215,45,14,WS_GROUP
    PUSHBUTTON      "Cancel",IDCANCEL,190,215,45,14,WS_GROUP
    PUSHBUTTON      "&Apply",1026,92,215,45,14,WS_GROUP
    PUSHBUTTON      "&Help",1038,43,215,45,14,WS_GROUP
END


