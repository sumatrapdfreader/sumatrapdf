+/* SumatraPDF: the alpha of an rgba() color, 1 for any other color (#6339) */
+float
+svg_parse_color_alpha(const char *str)
+{
+	const char *p = strstr(str, "rgba(");
+	char *end;
+	float a;
+	int i;
+
+	if (!p)
+		return 1;
+	for (i = 0; i < 3 && p; i++)
+	{
+		p = strchr(p, ',');
+		if (p)
+			++p;
+	}
+	if (!p)
+		return 1;
+
+	a = fz_strtof(p, &end);
+	if (end == p)
+		return 1;
+	if (*end == '%')
+		a /= 100;
+	return fz_clamp(a, 0, 1);
+}
