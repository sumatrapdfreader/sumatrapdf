+static fz_text_language guess_text_language(fz_context *ctx, const char *text)
+{
+	int kana = 0, hangul = 0, bopomofo = 0;
+	int han = 0, hans = 0, hant = 0, japan = 0;
 	int c;
+
+	if (!text)
