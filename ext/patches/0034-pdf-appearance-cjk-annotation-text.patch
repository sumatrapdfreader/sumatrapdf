+	if (hangul)
+		return FZ_LANG_ko;
+	if (bopomofo)
+		return FZ_LANG_zh_Hant;
+	if (!han)
+		return FZ_LANG_UNSET;
+
+	/* otherwise go by which collection covers most of the Han characters */
+	if (hans >= hant && hans >= japan)
