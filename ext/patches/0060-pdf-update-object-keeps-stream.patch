pdf_update_object: keep the stream when the entry moves sections

With no incremental section the new entry starts empty, so replacing
a stream's dictionary left its data in the old section. Saving with
garbage=3 hit this: a found duplicate runs a second garbage pass on the
collapsed xref, and renumbering rewrote every stream dictionary that
holds an indirect reference. A stream added in the session came out as
a dictionary with /Length and no data.

diff --git a/source/pdf/pdf-xref.c b/source/pdf/pdf-xref.c
index 6f01a7ec4..b28f756f9 100644
--- a/source/pdf/pdf-xref.c
+++ b/source/pdf/pdf-xref.c
@@ -2948,7 +2948,7 @@ pdf_update_local_object(fz_context *ctx, pdf_document *doc, int num, pdf_obj *ne
 void
 pdf_update_object(fz_context *ctx, pdf_document *doc, int num, pdf_obj *newobj)
 {
-	pdf_xref_entry *x;
+	pdf_xref_entry *x, *old;
 
 	if (!doc)
 		return;
@@ -2971,8 +2971,20 @@ pdf_update_object(fz_context *ctx, pdf_document *doc, int num, pdf_obj *newobj)
 		return;
 	}
 
+	old = pdf_get_xref_entry_no_change(ctx, doc, num);
 	x = pdf_get_incremental_xref_entry(ctx, doc, num);
 
+	/* A fresh incremental entry starts empty: carry the stream over
+	 * from the section that held the object, so replacing a stream's
+	 * dictionary keeps its data. */
+	if (old && old != x && old->type && x->type == 0)
+	{
+		x->stm_buf = old->stm_buf;
+		old->stm_buf = NULL;
+		x->stm_ofs = old->stm_ofs;
+		x->gen = old->gen;
+	}
+
 	pdf_drop_obj(ctx, x->obj);
 
 	x->type = 'n';
