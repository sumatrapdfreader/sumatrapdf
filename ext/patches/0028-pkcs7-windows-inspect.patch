+    int cert_der_len;
+} pkcs7_windows_ts_info;
+
+typedef struct {
+    char* signer_cn;
+    char* issuer_cn;
+    char* hash_algo;
+    char* sig_algo;
+    char* digest_hex;
+    int64_t not_after_unix;
+    int has_qc_statement;
+    int has_cades_attr;
+    int has_sig_policy_attr;
+    unsigned char* cert_der;
+    int cert_der_len;
