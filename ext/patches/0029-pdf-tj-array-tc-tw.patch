pdf-interpret: keep parsing TJ arrays that contain Tc/Tw (issue #4157)

Broken PDF generators put "0.0 Tc" (or Tw) inside a TJ array. MuPDF already
applied those operators, then fell through to a syntax error. After 100 such
errors the rest of the page is dropped, so later text (often the CID-font
body of a datasheet) never draws.

Break after a successful Tc/Tw instead of throwing.

Fixes https://github.com/sumatrapdfreader/sumatrapdf/issues/4157
---
diff --git a/source/pdf/pdf-interpret.c b/source/pdf/pdf-interpret.c
index cf4cf0949..dc7c23e80 100644
--- a/source/pdf/pdf-interpret.c
+++ b/source/pdf/pdf-interpret.c
@@ -1584,6 +1584,10 @@ pdf_process_stream(fz_context *ctx, pdf_processor *proc, pdf_csi *csi, fz_stream
 					case PDF_TOK_EOF:
 						break;
 					case PDF_TOK_KEYWORD:
+						/* Broken generators put "0 Tc" / "0 Tw" inside a TJ array
+						 * (issue #4157). Apply the operator and keep parsing the
+						 * array; do not fall through to a syntax error that, after
+						 * enough hits, drops the rest of the page. */
 						if (buf->scratch[0] == 'T' && (buf->scratch[1] == 'w' || buf->scratch[1] == 'c') && buf->scratch[2] == 0)
 						{
 							int n = pdf_array_len(ctx, csi->obj);
@@ -1595,10 +1599,11 @@ pdf_process_stream(fz_context *ctx, pdf_processor *proc, pdf_csi *csi, fz_stream
 									csi->stack[0] = pdf_to_real(ctx, o);
 									pdf_array_delete(ctx, csi->obj, n-1);
 									pdf_process_keyword(ctx, proc, csi, stm, buf->scratch);
+									break;
 								}
 							}
 						}
-						/* Deliberate Fallthrough! */
+						fz_throw(ctx, FZ_ERROR_SYNTAX, "syntax error in array");
 					default:
 						fz_throw(ctx, FZ_ERROR_SYNTAX, "syntax error in array");
 					}
