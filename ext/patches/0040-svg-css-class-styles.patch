+	doc->classes = NULL;
 	if (base_uri)
 		fz_strlcpy(doc->base_uri, base_uri, sizeof doc->base_uri);
 	doc->zip = zip;
@@ -162,6 +350,7 @@ svg_open_document_with_buffer(fz_context *ctx, fz_buffer *buf, const char *base_
 		doc->xml = fz_parse_xml(ctx, buf, 0);
 		doc->root = fz_xml_root(doc->xml);
