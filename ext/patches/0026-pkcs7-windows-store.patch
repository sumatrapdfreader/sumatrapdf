                                                     const char* pw) {
     windows_signer* signer = NULL;
@@ -647,32 +717,7 @@ static pdf_pkcs7_signer* pkcs7_windows_read_pfx_imp(fz_context* ctx, const char*
             fz_throw(ctx, FZ_ERROR_GENERIC, "PFX has no cert with a private key");
         }
 
