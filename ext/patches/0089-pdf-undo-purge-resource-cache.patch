@@ -1500,7 +1503,10 @@ void pdf_redo(fz_context *ctx, pdf_document *doc)
 	pdf_drop_page_tree_internal(ctx, doc);
 	pdf_sync_open_pages(ctx, doc);
 	for (frag = entry->head; frag; frag = frag->next)
