pdf: a password can carry the raw encryption key

A document unlocked with a key remembered by the app has no password, so
tools re-opening it from disk could not authenticate. A password of
PDF_RAW_KEY_PASSWORD_PREFIX + the key in hex now does, for every tool that
takes -p, and the tools still write the original encryption.
---
diff --git a/include/mupdf/pdf/crypt.h b/include/mupdf/pdf/crypt.h
index 4d323472e..6a7feb783 100644
--- a/include/mupdf/pdf/crypt.h
+++ b/include/mupdf/pdf/crypt.h
@@ -64,6 +64,10 @@ unsigned char *pdf_crypt_user_encryption(fz_context *ctx, pdf_crypt *crypt);
 unsigned char *pdf_crypt_permissions_encryption(fz_context *ctx, pdf_crypt *crypt);
 unsigned char *pdf_crypt_key(fz_context *ctx, pdf_crypt *crypt);
 
+/* SumatraPDF: a password of this prefix + the 32 bytes of pdf_crypt_key() in
+ * hex unlocks a document, for tools re-opening one the app already unlocked. */
+#define PDF_RAW_KEY_PASSWORD_PREFIX "\001key:"
+
 void pdf_print_crypt(fz_context *ctx, fz_output *out, pdf_crypt *crypt);
 
 void pdf_write_digest(fz_context *ctx, fz_output *out, pdf_obj *byte_range, pdf_obj *field, size_t digest_offset, size_t digest_length, pdf_pkcs7_signer *signer);
diff --git a/source/pdf/pdf-crypt.c b/source/pdf/pdf-crypt.c
index b9659f50f..e7e618df4 100644
--- a/source/pdf/pdf-crypt.c
+++ b/source/pdf/pdf-crypt.c
@@ -783,6 +783,41 @@ static void pdf_saslprep_from_utf8(char *password, const char *utf8, int n)
 	fz_strlcpy(password, utf8, n);
 }
 
+static int
+hex_value(int c)
+{
+	if (c >= '0' && c <= '9')
+		return c - '0';
+	if (c >= 'a' && c <= 'f')
+		return c - 'a' + 10;
+	if (c >= 'A' && c <= 'F')
+		return c - 'A' + 10;
+	return -1;
+}
+
+/* SumatraPDF: see PDF_RAW_KEY_PASSWORD_PREFIX */
+static int
+authenticate_raw_key(pdf_crypt *crypt, const char *pwd)
+{
+	size_t prefix = strlen(PDF_RAW_KEY_PASSWORD_PREFIX);
+	const char *hex = pwd + prefix;
+	unsigned char key[32];
+	size_t i;
+
+	if (strncmp(pwd, PDF_RAW_KEY_PASSWORD_PREFIX, prefix) != 0 || strlen(hex) != 2 * sizeof key)
+		return 0;
+	for (i = 0; i < sizeof key; i++)
+	{
+		int hi = hex_value(hex[2 * i]);
+		int lo = hex_value(hex[2 * i + 1]);
+		if (hi < 0 || lo < 0)
+			return 0;
+		key[i] = (unsigned char)(hi * 16 + lo);
+	}
+	memcpy(crypt->key, key, sizeof key);
+	return 1;
+}
+
 int
 pdf_authenticate_password(fz_context *ctx, pdf_document *doc, const char *pwd_utf8)
 {
@@ -791,6 +826,12 @@ pdf_authenticate_password(fz_context *ctx, pdf_document *doc, const char *pwd_ut
 	if (!doc->crypt)
 		return 1; /* No password required */
 
+	if (pwd_utf8 && authenticate_raw_key(doc->crypt, pwd_utf8))
+	{
+		doc->crypt->access = 2;
+		return doc->crypt->access;
+	}
+
 	password[0] = 0;
 	if (pwd_utf8)
 	{
