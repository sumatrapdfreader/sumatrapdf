+/* is word one of the space separated words in list? */
+static int has_word(const char *list, const char *word)
+{
+	size_t n = strlen(word);
+	const char *s = list;
+	if (!s)
+		return 0;
+	while (*s)
+	{
+		while (iswhite(*s))
+			s++;
+		if (!strncmp(s, word, n) && (s[n] == 0 || iswhite(s[n])))
+			return 1;
+		while (*s && !iswhite(*s))
+			s++;
+	}
+	return 0;
+}
