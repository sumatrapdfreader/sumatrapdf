A password text field's appearance stream shows '*' for each character,
never the text.

pdf_write_widget_appearance() wrote the field's value into the appearance
stream as is, so the typed password was saved in the PDF in the clear, and
shown by viewers that use the appearance. Only the masking half of Vira
Reader's mupdf-password-appearance.patch; it also ignores a password field's
own stored appearance, which is the file's, not something we leak.

diff --git a/source/pdf/pdf-appearance.c b/source/pdf/pdf-appearance.c
index 0eebcd806..276ffe4b7 100644
--- a/source/pdf/pdf-appearance.c
+++ b/source/pdf/pdf-appearance.c
@@ -3157,7 +3157,26 @@ pdf_write_widget_appearance(fz_context *ctx, pdf_annot *annot, fz_buffer *buf,
 			text = pdf_field_value(ctx, annot->obj);
 		}
 		fz_try(ctx)
+		{
+			/* SumatraPDF: a password field's appearance stream is saved in
+			 * the file; write one '*' per character, never the text (idea
+			 * from Vira Reader). */
+			if ((ff & PDF_TX_FIELD_IS_PASSWORD) && text)
+			{
+				char *mask = fz_malloc(ctx, strlen(text) + 1);
+				const char *p = text;
+				int n = 0, c;
+				while (*p)
+				{
+					p += fz_chartorune(&c, p);
+					mask[n++] = '*';
+				}
+				mask[n] = 0;
+				fz_free(ctx, format);
+				text = format = mask;
+			}
 			pdf_write_tx_widget_appearance(ctx, annot, buf, rect, bbox, matrix, res, text, ff);
+		}
 		fz_always(ctx)
 			fz_free(ctx, format);
 		fz_catch(ctx)
