+/* index of the next grid line to draw after k: the farthest one at most 2 device pixels away (#6402) */
+static int
+type1_next_line(const float *pos, int last, int k, float scale)
+{
+	int j = k + 1;
+	while (j < last && fabsf(pos[j + 1] - pos[k]) * scale <= 2)
+		j++;
+	return j;
+}
