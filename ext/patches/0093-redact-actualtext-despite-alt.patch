Redaction: a non-matching /Alt no longer stops /ActualText being redacted.

mcid_char_imp() walks a tagged element's /Alt and /ActualText alongside the
removed text. When either string stopped matching it, mupdf gave up on both:
it deleted only the string that mismatched and stopped editing the element.
An /Alt is usually a description, not the text, so it mismatches at once, and
/ActualText kept the redacted words. Now each string is handled on its own: a
mismatched one is deleted, the other keeps being edited.

diff --git a/source/pdf/pdf-op-filter.c b/source/pdf/pdf-op-filter.c
index 5996325e5..2d90855f2 100644
--- a/source/pdf/pdf-op-filter.c
+++ b/source/pdf/pdf-op-filter.c
@@ -842,6 +842,17 @@ walk_string(fz_context *ctx, int uni, int remove, editable_str *str)
 	while (rune != uni);
 }
 
+static void
+drop_unmatched_string(fz_context *ctx, tag_record *tr, editable_str *str, pdf_obj *key)
+{
+	if (str->utf8 == NULL || str->pos != -1)
+		return;
+	pdf_dict_del(ctx, tr->mcid_obj, key);
+	fz_free(ctx, str->utf8);
+	str->utf8 = NULL;
+	str->edited = 0;
+}
+
 /* For a given character we've processed (removed or not)
  * consider it in the tag_record. Try and step over it in
  * the Alt or ActualText strings, removing if possible.
@@ -869,31 +880,20 @@ mcid_char_imp(fz_context *ctx, pdf_sanitize_processor *p, tag_record *tr, int un
 	/* Edit the ActualText string */
 	walk_string(ctx, uni, remove, &tr->actualtext);
 
-	/* If we're removing a character, and either of the strings
-	 * haven't matched up to what we were expecting, then just
-	 * delete the whole string. */
-	if (remove)
-		remove = (tr->alt.pos == -1 || tr->actualtext.pos == -1);
-	else if (tr->alt.pos >= 0 || tr->actualtext.pos >= 0)
-	{
-		/* The strings are making sense so far */
-		remove = 0;
-	}
+	if (!remove)
+		return;
 
-	if (remove)
+	/* A string that hasn't matched up to what we were expecting
+	 * can't have the removed character taken out, so err on the
+	 * side of caution and delete it. Keep editing the other one:
+	 * an /Alt is usually a description, not the text, and giving
+	 * up on both left /ActualText with the removed text in it. */
+	drop_unmatched_string(ctx, tr, &tr->alt, PDF_NAME(Alt));
+	drop_unmatched_string(ctx, tr, &tr->actualtext, PDF_NAME(ActualText));
+	if (tr->alt.utf8 == NULL && tr->actualtext.utf8 == NULL)
 	{
-		/* Anything else we have to err on the side of caution and
-		 * delete everything that might leak info. */
-		if (tr->actualtext.pos == -1)
-			pdf_dict_del(ctx, tr->mcid_obj, PDF_NAME(ActualText));
-		if (tr->alt.pos == -1)
-			pdf_dict_del(ctx, tr->mcid_obj, PDF_NAME(Alt));
 		pdf_drop_obj(ctx, tr->mcid_obj);
 		tr->mcid_obj = NULL;
-		fz_free(ctx, tr->alt.utf8);
-		tr->alt.utf8 = NULL;
-		fz_free(ctx, tr->actualtext.utf8);
-		tr->actualtext.utf8 = NULL;
 	}
 }
 
